        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{availableBookId}}\n}"
        },
        "url": "{{baseUrl}}/api/loans",
        "description": "Alur E2E peminjaman: Gateway -> Loan Service -> Book Service -> Book DB, kemudian Loan DB dan update status buku. Default bookId=2. Expected: 201 jika buku tersedia. Login dahulu dan gunakan JWT Bearer token; username diambil dari token."
      },
      "response": []
    },
