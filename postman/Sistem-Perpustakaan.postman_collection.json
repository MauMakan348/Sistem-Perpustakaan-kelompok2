        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{borrowedBookId}}\n}"
        },
        "url": "{{baseUrl}}/api/loans",
        "description": "Default borrowedBookId=1 berdasarkan data awal. Expected: 409 jika status buku dipinjam."
      },
      "response": []
    },
    {
      "name": "3E. POST Loan - Buku Tidak Ditemukan",
      "request": {
        "method": "POST",
        "header": [
          {
