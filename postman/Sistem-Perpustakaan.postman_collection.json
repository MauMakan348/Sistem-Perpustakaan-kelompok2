        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "description": "Pastikan availableBookId menunjuk buku tersedia dan akun belum mencapai batas 3 pinjaman aktif.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{availableBookId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201)); if(pm.response.code===201){const loan=pm.response.json().loan;pm.environment.set('loanId',String(loan.id));pm.environment.set('borrowedBookId',String(loan.bookId));pm.test('loan active',()=>pm.expect(loan.status).to.eql('active'));pm.test('due date is exactly 7x24 hours',()=>pm.expect(new Date(loan.dueDate).getTime()-new Date(loan.borrowDate).getTime()).to.eql(7*24*60*60*1000));}"
            ]
          }
        }
      ]
    },
