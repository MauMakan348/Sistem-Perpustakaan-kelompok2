    {
      "name": "00 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Publik. Memeriksa proses backend menjawab."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200)); pm.test('health ok',()=>pm.expect(pm.response.json().status).to.eql('ok'))"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Register test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "description": "Buat akun uji baru. Isi username unik dan password hanya pada environment lokal.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201)); if(pm.response.code===201){pm.environment.set('userId',String(pm.response.json().user.id)); pm.environment.set('username',pm.response.json().user.username); pm.test('no password hash in response',()=>pm.expect(JSON.stringify(pm.response.json())).not.to.include('password_hash'));}"
            ]
          }
        }
      ]
    },
