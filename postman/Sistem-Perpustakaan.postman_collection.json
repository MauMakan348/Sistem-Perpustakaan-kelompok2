        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/api/loans",
        "description": "Body tidak berisi bookId. Expected: 400 setelah token valid."
      },
      "response": []
    },
    {
