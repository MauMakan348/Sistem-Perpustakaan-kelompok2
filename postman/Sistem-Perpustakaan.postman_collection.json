    {
      "name": "05 Books list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        },
        "description": "JWT user atau API Key diperlukan."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200)); if(pm.response.code===200 && Array.isArray(pm.response.json())){const books=pm.response.json();const available=books.find(b=>b.status==='tersedia');const borrowed=books.find(b=>b.status==='dipinjam');if(available)pm.environment.set('availableBookId',String(available.id));if(borrowed)pm.environment.set('borrowedBookId',String(borrowed.id));pm.test('list response is array',()=>pm.expect(books).to.be.an('array'));}"
            ]
          }
        }
      ]
    },
