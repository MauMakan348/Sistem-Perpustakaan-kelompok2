        "url": "{{baseUrl}}/api/books",
        "description": "Isi collection variable userToken dengan JWT dari akun role=user. Expected: 403."
      },
      "response": []
    },
    {
      "name": "3. POST Loan - Buku Tersedia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
