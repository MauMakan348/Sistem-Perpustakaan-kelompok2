{
  "info": {
    "_postman_id": "7d8b2d10-9c3a-4f36-9f1b-5e2c1d7a9012",
    "name": "Sistem Perpustakaan - API Gateway",
    "description": "Skenario pengujian API melalui API Gateway. Registrasi/login dapat diakses tanpa API Key agar frontend dapat memulai sesi. Request lain menggunakan API Key untuk client tepercaya atau JWT Bearer untuk pengguna login. Login menyimpan JWT ke collection variable token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "apiKey",
      "value": "your_api_key_here"
    },
    {
      "key": "username",
      "value": "kokop"
    },
    {
      "key": "availableBookId",
      "value": "2"
    },
    {
      "key": "borrowedBookId",
      "value": "1"
    },
    {
      "key": "notFoundBookId",
      "value": "999999"
    },
    {
      "key": "password",
      "value": "TestPassword123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Registrasi Pengguna",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"}"
        },
        "url": "{{baseUrl}}/api/register",
        "description": "Membuat akun baru. Endpoint registrasi tidak memerlukan API Key agar frontend dapat memulai registrasi. Expected: 201; username duplikat: 409; input invalid: 400."
      },
      "response": []
    },
    {
      "name": "0A. Login Pengguna dan Simpan Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.token) pm.collectionVariables.set(\"token\", body.token);",
              "  if (body.user && body.user.username) pm.collectionVariables.set(\"username\", body.user.username);",
              "}",
              "pm.test(\"Login berhasil atau menampilkan error yang diharapkan\", function () {",
              "  pm.expect([200, 400, 401]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"}"
        },
        "url": "{{baseUrl}}/api/login",
        "description": "Login pengguna. Jika berhasil, test script menyimpan JWT pada collection variable token. Expected: 200; password salah: 401; input tidak lengkap: 400."
      },
      "response": []
    },
    {
      "name": "1. GET Books - API Key Benar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "description": "Daftar semua buku melalui API Gateway. Expected: 200 jika Book Service dan database tersedia."
      },
      "response": []
    },
    {
      "name": "1A. GET Books - API Key Salah",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "wrong-api-key"
          }
        ],
        "url": "{{baseUrl}}/api/books",
        "description": "Pengujian API Key salah. Expected: 401 dan request tidak diteruskan ke Book Service."
      },
      "response": []
    },
    {
      "name": "1B. GET Books - API Key Tidak Dikirim",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/books",
        "description": "Pengujian tanpa X-API-Key. Expected: 401."
      },
      "response": []
    },
    {
      "name": "2. GET Book by ID - Ditemukan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{availableBookId}}",
        "description": "Ambil detail buku yang ada. Default availableBookId=2. Expected: 200."
      },
      "response": []
    },
    {
      "name": "2A. GET Book by ID - Tidak Ditemukan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{notFoundBookId}}",
        "description": "Ambil buku dengan ID yang tidak ada. Expected: 404 { error: \"Buku tidak ditemukan.\" }."
      },
      "response": []
    },
    {
      "name": "2B. POST Books - Admin Berhasil Menambah Buku",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buku Uji Tambah\",\n  \"author\": \"Penulis Uji\"\n}"
        },
        "url": "{{baseUrl}}/api/books",
        "description": "Login dengan akun yang sudah dipromosikan role=admin. Expected: 201, ID dibuat MySQL, status otomatis tersedia. Client tidak dapat menentukan status."
      },
      "response": []
    },
    {
